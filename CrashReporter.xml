<?xml version="1.0" encoding="UTF-8"?><languages>	<language id="English">	<str k="STR_WINDOW_TITLE" 			v="Targem Crash Reporter" />	<str k="STR_HEADER_TEXT" 			v="$(ProductName) has stopped working" />	<str k="STR_SORRY_TEXT" 			v="Sorry for the inconvenience" />	<str k="STR_DESC_TEXT" 				v="Please send us this error report. This really helps us to track down and fix any problems that cause our software to close.\nThank you!" />	<str k="STR_PLEASE_DESCRIBE_TEXT" 	v="Describe what happened just before $(ProductName) had to close:" />	<str k="STR_SEND_REPORT_BUTTON" 	v="Send report" />	<str k="STR_CANCEL_BUTTON" 			v="Quit" />	<str k="STR_PROGRESS_TEXT" 			v="Submitting your report…" />	<str k="STR_REPORT_CONTENT_LINK"	v="What does this report contain?" /></language><language id="Russian">		<str k="STR_WINDOW_TITLE" 			v="Targem Crash Reporter" />	<str k="STR_HEADER_TEXT" 			v="$(ProductName) прекратил работу" />	<str k="STR_SORRY_TEXT" 			v="Извините за причиненные неудобства" />	<str k="STR_DESC_TEXT" 				v="Пожалуйста, отправьте нам это сообщение об ошибке чтобы мы могли ее исправить.\nСделав это, вы действительно поможете нам повысить качество игры и избежать повторения подобных ситуаций. Спасибо!" />	<str k="STR_PLEASE_DESCRIBE_TEXT" 	v="Опишите свои действия во время возникновения ошибки:" />	<str k="STR_SEND_REPORT_BUTTON" 	v="Отправить отчет" />	<str k="STR_CANCEL_BUTTON" 			v="Выйти" />	<str k="STR_PROGRESS_TEXT" 			v="Идёт отправка сообщения..." />	<str k="STR_REPORT_CONTENT_LINK"	v="Что содержит данный отчет?" /></language></languages>