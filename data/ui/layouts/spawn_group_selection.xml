<?xml version="1.0" encoding="UTF-8"?>
<Ui>
	<Form name="SpawnGroupSelectionUI"
		class="SpawnGroupSelectionUI" 
		width="100" 
		height="100"
		resizable="false"
		movable="false"
		font="Tiny_Bold"
		text="Select Spawn"
		foreground="White"
		background="White"
		enable_title="true"
		enable_close_button="false">
		
		<anchor point="BOTTOM_RIGHT" y="-50" />
		
		<LinearLayout w="100" h="100" x="0" y="00" horizontal="false" margin="2" debug="false">
			<Button name="SpawnGroupButton0" text="default" w="100" h="20" text_align="center"/>
			<Button name="SpawnGroupButton1" text="1 group" w="100" h="20" text_align="center"/>
			<Button name="SpawnGroupButton2" text="2 group" w="100" h="20" text_align="center"/>
			<Button name="SpawnGroupButton3" text="3 group" w="100" h="20" text_align="center"/>
		</LinearLayout>	
	</Form>
</Ui>
