<?xml version="1.0" encoding="UTF-8"?>
<Ui>
	<Templates>

		<LinearLayout name="InstanceInfoTemplate" w="785" h="21" horizontal="true" margin="10" debug="false">
			<TextLabel name="$parent_InstanceId" text="189377" w="110" h="20" text_align="vcenter right"/>
			<TextLabel name="$parent_ZoneId" text="189" w="50" h="20" text_align="center"/>
			<TextLabel name="$parent_ZoneName" text="pandora_astrroid" w="270" text="Mode" h="20" text_align="vcenter left"/>
			<TextLabel name="$parent_Clients" text="24" w="50" h="20" text_align="center"/>
			<TextLabel name="$parent_FreeSlots" text="18" w="50" h="20" text_align="center"/>
			<TextLabel name="$parent_Region" text="EU" w="90" h="20" text_align="center"/>
			<TextLabel name="$parent_Time" text="00:05" w="55" h="20" text_align="vcenter right"/>
			<Button name="$parent_JumpButton" text="Jump" w="40" h="20" text_align="center"/>
		</LinearLayout>

	</Templates>


	<Form name="ZoneInstanceListUI"
		class="ZoneInstanceListUI" 
		width="810" 
		height="600"
		resizable="false"
		movable="true"
		font="Tiny_outl2"
		text="Zone Instance List"
		foreground="White"
		background="White"
		x="200"
		y="100"
		alpha="1">

		<LinearLayout name="Header" w="785" h="25" horizontal="true" margin="10" debug="false" >
			<Button name="Sort_InstanceId" text="SessionId" w="110" h="24" text_align="vcenter right" background="Transparent"/>
			<Button name="Sort_ZoneId" text="ZoneId" w="50" h="24" text_align="center" background="Transparent"/>
			<Button name="Sort_ZoneName" text="ZoneName" w="270" h="24" text_align="center" background="Transparent"/>
			<Button name="Sort_Clients" text="Clients" w="50" h="24" text_align="center" background="Transparent"/>
			<Button name="Sort_FreeSlots" text="Slots" w="50" h="24" text_align="center" background="Transparent"/>
			<Button name="Sort_Region" text="Region" w="90" h="24" text_align="center" background="Transparent"/>
			<Button name="Sort_Time" text="Time" w="55" h="24" text_align="center" background="Transparent"/>

			<CheckButton name="HexModeCheckButton" text="Hex" checked="true" leftText="true">
				<anchor point="LEFT" to="Sort_InstanceId" />
			</CheckButton>
		</LinearLayout>

		<LinearLayout name="ListBlock" w="788" h="1" horizontal="false" margin="1" debug="false" >
			<anchor point="TOPLEFT" to="Header:BOTTOMLEFT" y="5" />
			<anchor point="BOTTOM" y="-42" />
			
			<Widget name="Record1"  template="InstanceInfoTemplate" />
			<Widget name="Record2"  template="InstanceInfoTemplate" />
			<Widget name="Record3"  template="InstanceInfoTemplate" />
			<Widget name="Record4"  template="InstanceInfoTemplate" />
			<Widget name="Record5"  template="InstanceInfoTemplate" />
			<Widget name="Record6"  template="InstanceInfoTemplate" />
			<Widget name="Record7"  template="InstanceInfoTemplate" />
			<Widget name="Record8"  template="InstanceInfoTemplate" />
			<Widget name="Record9"  template="InstanceInfoTemplate" />
			<Widget name="Record10" template="InstanceInfoTemplate" />
			<Widget name="Record11" template="InstanceInfoTemplate" />
			<Widget name="Record12" template="InstanceInfoTemplate" />
			<Widget name="Record13" template="InstanceInfoTemplate" />
			<Widget name="Record14" template="InstanceInfoTemplate" />
			<Widget name="Record15" template="InstanceInfoTemplate" />
			<Widget name="Record16" template="InstanceInfoTemplate" />
			<Widget name="Record17" template="InstanceInfoTemplate" />
			<Widget name="Record18" template="InstanceInfoTemplate" />
			<Widget name="Record19" template="InstanceInfoTemplate" />
			<Widget name="Record20" template="InstanceInfoTemplate" />
			<Widget name="Record21" template="InstanceInfoTemplate" />
			<Widget name="Record22" template="InstanceInfoTemplate" />
			<Widget name="Record23" template="InstanceInfoTemplate" />
			<Widget name="Record24" template="InstanceInfoTemplate" />
			
		</LinearLayout>

		<ScrollBar name="Scrollbar" width="18" height="1">
			<anchor point="TOPLEFT" to="ListBlock:TOPRIGHT" x="4" />
			<anchor point="BOTTOMLEFT" to="ListBlock:BOTTOMRIGHT" x="4" />
		</ScrollBar>
		
		<TextLabel name="FindUserLabel" text="Find User:" >
			<anchor point="BOTTOMLEFT" x="10" y="-10" />
		</TextLabel>
		
		<TextEntry name="FindUserEntry" hint="User NickName or #uid" width="140" height="20" >
			<anchor point="LEFT" to="FindUserLabel:RIGHT" x="3" />
		</TextEntry>

		<TextLabel name="FindResult" text="not Found" width="420" height="20" >
			<anchor point="LEFT" to="FindUserEntry:RIGHT" x="10" />
		</TextLabel>

		<Button name="RefreshButton" text="Refresh" w="130" h="22">
			<anchor point="BOTTOMRIGHT" x="-10" y="-7" />
		</Button>

	</Form>
</Ui>
