base_res 1280 720

animations 1
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
}

total_elements 2

objects 2
{
	object blackout
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 20 20
			effect "ui\graphics\hangar\blackout"
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle
	}
	object win
	{
		defaults
		{
			anchor "C"
			pos 425 238
			opacity 255
			color 0xffffffff
			size 430 180
			effect "ui\graphics\clan\clan_create_win"
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle
	}
}

