{
	object self
	{
		defaults
		{
			pos 1 -1
			opacity 255
			color 0xffffffff
			size 220 24
			effect ""
			alignment "CM"
			font "VerySmall_outl2"
		}
		visible_on online
		visible_on offline
	}
	object text_2
	{
		defaults
		{
			pos 1 -0
			opacity 255
			color 0xff00ff00
			size 200 20
			effect ""
			alignment "RM"
			sampleText "wdffeegegege"
			font "Tiny"
		}
		visible_on online
		anim offline obj_colc
		{
			1
			0xffff2700
		}
	}
	object on_off
	{
		defaults
		{
			pos 203 4
			opacity 255
			color 0xffffffff
			size 12 12
			effect "ui\graphics\friend\friend_line_on_off"
			alignment "RM"
			font "Tiny"
		}
