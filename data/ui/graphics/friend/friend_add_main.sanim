base_res 1280 720

animations 1
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
}

total_elements 3

objects 3
{
	object blackout
	{
		defaults
		{
			anchor "LT"
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 480 250
			effect "ui\graphics\hangar\blackout"
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle
	}
	object win
	{
		defaults
		{
			anchor "C"
			pos 398 204
			opacity 255
			color 0xffffffff
			size 480 250
			effect "ui\graphics\friend\friend_add_win"
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle
	}
	object self
	{
		defaults
		{
			anchor "LT"
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 1280 720
			effect ""
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle
	}
}

