animations 2
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
	anim no_reputation
	{
		mode looped
		cycle_time 1
	}
}

total_elements 2

objects 1
{
	object self
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 24 21
			effect ""
			alignment "LT"
		}
		visible_on idle
		visible_on no_reputation
	}
}

