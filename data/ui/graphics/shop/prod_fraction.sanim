{
	total_vertices 4

	sprite ico
	{
		defaults
		{
			rows 2
			cols 2
			texture "textures/uv_01_01.tif"
			vertices
			{
				1.5 -1.5	22.5 -1.5	1.5 19.5	22.5 19.5	
				-9.31323e-009 0	1 0	-9.31323e-009 1	1 1	
				0xffffffff	0xffffffff	0xffffffff	0xffffffff	
			}
		}
		visible_on idle
		anim no_reputation sp_colc
		{
			1
			0xffce0000	0xffce0000	0xffce0000	0xffce0000	
		}
	}
}

