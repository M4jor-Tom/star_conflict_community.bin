animations 3
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
	anim over
	{
		mode looped
		cycle_time 1
	}
	anim press
	{
		mode looped
		cycle_time 1
	}
}

total_elements 3

objects 3
{
	object input
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 160 14
			effect "ui\graphics\shop\search_input"
			alignment "LT"
		}
		visible_on idle
		visible_on over
		visible_on press
	}
	object search_btn
	{
		defaults
		{
			pos 160 0.868885
			opacity 255
			color 0xffffffff
			size 15 14
			effect "ui\graphics\shop\search_btn"
			alignment "LT"
		}
		visible_on idle
		visible_on over
		visible_on press
	}
	object self
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 175 14
			effect ""
			alignment "LT"
		}
		visible_on idle
		visible_on over
		visible_on press
	}
}

