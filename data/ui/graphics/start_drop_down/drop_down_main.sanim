animations 2
{
	anim select
	{
		mode looped
		cycle_time 1
	}
	anim deselect
	{
		mode looped
		cycle_time 1
	}
}

total_elements 4

objects 4
{
	object drop_down_btn
	{
		defaults
		{
			pos 0 205
			opacity 255
			color 0xffffffff
			size 390 22
			effect "ui\graphics\start_drop_down\drop_down_btn"
			alignment "LT"
		}
		visible_on select
		visible_on deselect
	}
	object list
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 20 202
			effect "ui\graphics\start_drop_down\drop_down_list"
			alignment "LT"
		}
		visible_on select
		visible_on deselect
	}
	object drop_down_input
	{
		defaults
		{
			pos 0 205
			opacity 255
			color 0xffffffff
			size 20 22
			effect "ui\graphics\start_drop_down\drop_down_input"
			alignment "LT"
		}
		visible_on select
		visible_on deselect
	}
	object self
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 215 227
			effect ""
			alignment "LT"
		}
		visible_on select
		visible_on deselect
	}
}

