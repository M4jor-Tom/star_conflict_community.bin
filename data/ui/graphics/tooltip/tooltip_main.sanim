			pos 0 -0
			opacity 255
			color 0xffffffff
			size 454 405
			effect ""
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle
	}
	object tooltip_slot
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 454 405
			effect "ui\graphics\tooltip\tooltip_slot"
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle
	}
