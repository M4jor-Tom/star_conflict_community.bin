source_file "Y:/art/source/ui/graphics/ships_tree/ships_tree.ma"
//by sergey_mitryaev
//at Fri Dec 14 18:06:46 2012

base_res 1280 720
keep_screen_size

animations 1
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
}

total_elements 1

objects 1
{
	object scroll
	{
		defaults
		{
			anchor "LR"
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 1260 10
			effect "ui\graphics\scroll\scroll_h_main"
			alignment "LT"
			font "Tiny"
		}
		visible_on idle
	}
}

