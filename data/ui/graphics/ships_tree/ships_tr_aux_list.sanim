base_res 1280 720
keep_screen_size

animations 1
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
}

total_elements 1

objects 1
{
	object list
	{
		defaults
		{
			anchor "LR"
			pos 9 -0
			opacity 255
			color 0xffffffff
			size 1200 525
			effect "ui\graphics\ships_tree\ships_tr_list"
			alignment "LT"
			font "Tiny"
		}
		visible_on idle
	}
}

