		}
		visible_on idle
	}
	object self
	{
		defaults
		{
			anchor "R"
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 370 20
			effect ""
			alignment "RM"
			font "VerySmall_outl"
			blend color_add
		}
		visible_on idle
	}
}

