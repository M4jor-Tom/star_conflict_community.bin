animations 2
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
	anim select
	{
		mode looped
		cycle_time 1
	}
}

total_elements 3

objects 3
{
	object timer_1
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffff0f00
			size 100 20
			effect ""
			alignment "CM"
			sampleText "226:35"
			font "VerySmall_outl"
			blend color_add
		}
		visible_on idle
		visible_on select
	}
	object timer_2
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 100 20
			effect ""
			alignment "CM"
			sampleText "226:35"
			font "VerySmall"
		}
		visible_on idle
		visible_on select
	}
	object self
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 100 20
			effect ""
			alignment "CM"
			font "VerySmall_outl"
			blend color_add
		}
		visible_on idle
		visible_on select
	}
}

