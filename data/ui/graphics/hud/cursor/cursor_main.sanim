	object hit
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 30 30
			effect "ui\graphics\hud\cursor\cursor_hit"
			alignment "LT"
		}
		visible_on idle
		visible_on blink
	}
	object sinergy
	{
		defaults
		{
			pos -50 -65
			opacity 255
			color 0xffffffff
			size 100 15
			effect "ui\graphics\hud\cursor\cursor_sinergy"
			alignment "CM"
			font "VerySmall_outl"
