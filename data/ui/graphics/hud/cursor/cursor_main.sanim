		}
		visible_on idle
		visible_on blink
	}
	object disintegrator_prog
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 26 10
			effect "ui\graphics\hud\disintegrator_prog"
			alignment "LT"
		}
		visible_on idle
		visible_on blink
	}
	object dist_min
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 2 10
			effect ""
			alignment "LT"
		}
		visible_on idle
		visible_on blink
	}
	object rect
	{
		defaults
		{
			pos -120 -120
			opacity 255
			color 0xffffffff
			size 240 240
