animations 2
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
	anim damage
	{
		mode once
		cycle_time 0.3
	}
}

total_elements 2

objects 2
{
	object self
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 70 230
			effect ""
			alignment "LT"
		}
		visible_on idle
		visible_on damage
	}
	object armor_progress
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xff88b5ff
			size 70 230
			effect "ui\graphics\hud\armor_progress_n"
			alignment "LT"
		}
		visible_on idle
		anim damage obj_col
		{
			6
			0xffffffff
			0xfff6f9ff
			0xffe0ecff
			0xffc3d9ff
			0xffa4c6ff
			0xff88b5ff
		}
	}
}

