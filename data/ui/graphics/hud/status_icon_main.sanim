animations 1
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
}

total_elements 2

objects 2
{
	object dist
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 36 10
			effect ""
			alignment "LM"
		}
		visible_on idle
	}
	object center
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 0 0
			effect ""
			alignment "LT"
			blend color_add
		}
		visible_on idle
	}
}

