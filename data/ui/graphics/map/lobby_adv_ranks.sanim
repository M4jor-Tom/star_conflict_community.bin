{
	object chek_box
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 20 20
			effect "ui\graphics\option\chek_box"
			alignment "LM"
			font "VerySmall"
		}
		visible_on idle_1
		visible_on idle_2
	}
	object text
	{
		defaults
		{
			pos -4.19082 20.5815
			opacity 255
			color 0xffffffff
			size 30 20
			effect ""
			alignment "CM"
			sampleText "15"
			font "VerySmall"
		}
		visible_on idle_1
		anim idle_2 obj_colc
		{
			1
			0xffcccccc
		}
	}
	object self
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 20 40
			effect ""
			alignment "LM"
			font "VerySmall"
		}
		visible_on idle_1
		visible_on idle_2
	}
