animations 2
{
	anim idle_1
	{
		mode looped
		cycle_time 1
	}
	anim idle_2
	{
		mode looped
		cycle_time 1
	}
}

total_elements 2

objects 2
{
	object self
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 70 28
			effect ""
			alignment "CM"
			font "VerySmall"
		}
		visible_on idle_1
		visible_on idle_2
	}
	object text
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xff07ff00
			size 70 28
			effect ""
			alignment "CM"
			sampleText "в бою"
			font "VerySmall"
		}
		visible_on idle_1
		anim idle_2 obj_colc
		{
			1
			0xffff2700
		}
	}
}

