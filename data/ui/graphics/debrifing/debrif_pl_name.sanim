animations 2
{
	anim idle
	{
		mode looped
		cycle_time 1
	}
	anim myself
	{
		mode looped
		cycle_time 1
	}
}

total_elements 1

objects 1
{
	object |name
	{
		defaults
		{
			pos 0 -0
			opacity 255
			color 0xffffffff
			size 200 17
			effect ""
			alignment "LB"
			sampleText "Имя игрока"
			font "VerySmall"
		}
		visible_on idle
		anim myself obj_colc
		{
			1
			0xffff9100
		}
	}
}

